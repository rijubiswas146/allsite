# Environment variables template for Linker Nest
PORT=3000

# Telegram Bot API Configuration
# 1. Create a bot via @BotFather on Telegram (e.g. /newbot) and paste the API token here:
TELEGRAM_BOT_TOKEN=

# 2. Telegram chat ID where website suggestions should be sent:
# Provide your numeric Telegram user ID or channel ID:
TELEGRAM_CHAT_ID=

# Optional: Custom contact endpoints
TELEGRAM_ADMIN_URL=
INSTAGRAM_DEV_URL=

# Optional: Google Gemini API Key if AI features are enabled
GEMINI_API_KEY=
